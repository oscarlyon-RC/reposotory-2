{
    "name": "F1 Tracker",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "web",
    "workspaceFolder": "/var/www/html",
    "forwardPorts": [8080, 8081, 3306],
    "portsAttributes": {
        "8080": {
            "label": "F1 Tracker (web)",
            "onAutoForward": "openPreview",
            "visibility": "public"
        },
        "8081": {
            "label": "phpMyAdmin"
        }
    },
    "postCreateCommand": "echo 'F1 Tracker is ready. Open the forwarded port 8080 to view it.'"
}
